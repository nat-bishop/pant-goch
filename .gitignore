# Large model weights (~8 GB) — fetched via `make download-model`
models/
.download/

# Vendored llama.cpp binaries — fetched out-of-band, not source
vendor/

# Runtime logs
logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Godot
.godot/
.import/
*.translation

# .NET / C#
bin/
obj/
*.csproj.old
*.user

# OS / editors
.DS_Store
Thumbs.db
.vs/
.idea/
.vscode/

# Local-only Claude artifacts
.claude/settings.local.json

# Local-only Playwright MCP session artifacts (browser logs, page snapshots)
.playwright-mcp/

# TypeScript incremental build cache
*.tsbuildinfo

# Node / Vite
node_modules/
dist/
.vite/

# Backdrop / map variant histories — large, per-author, regenerable
world/backdrops/_variants/
world/_map_variants/

# Logfire project credentials (per-machine, contains write token)
.logfire/

# Local env overrides (.env.example is checked in)
.env
